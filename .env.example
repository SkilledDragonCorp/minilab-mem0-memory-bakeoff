# Telemetry off by default in lab + CI
MEM0_TELEMETRY=False

# Local mem0 storage (FAISS index + metadata)
MEMORY_BAKEOFF_DATA=.data/mem0

# Keyless stack (no API keys required for default tests)
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional LLM bench (infer=true) — skipped when unset
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
